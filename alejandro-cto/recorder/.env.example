# Copier en .env. Le .env n'est jamais poussé sur GitHub.
# La base se règle dans le .env à la racine du dépôt (README d'Henriquet) :
#   SUPABASE_URL=https://bvxmnrvqehemqsjiasdr.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=...   (demandée à Henriquet en message privé)
# Sans ces deux lignes, le Recorder écrit seulement dans le journal local (dossier journal/).

AUDIT_ID=aud_demo
UTILISATEUR_ID=usr_assistante
PROFIL_ID=immobilier

# Utilisées tant que les tables applis_autorisees / sites_autorises de Supabase sont vides.
# Noms exacts : "Google Chrome", "Microsoft Excel", "Numbers"...
# Démo : tableur de suivi = Google Sheets, donc dans Chrome (décision du 17/11).
APPLIS_AUTORISEES=Google Chrome
# Domaines (les sous-domaines sont inclus). Chrome coché sans site = rien n'est capté.
SITES_AUTORISES=ghost-portail-a.vercel.app,ghost-portail-b.vercel.app,ghost-portail-c.vercel.app,immogest.example,docs.google.com

# fenetre = normal ; ecran = plan B si la capture par fenêtre bloque
MODE_CAPTURE=fenetre
