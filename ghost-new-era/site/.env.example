# Copie ce fichier en .env.local et remplis les valeurs. .env.local n'est jamais envoyé sur GitHub.
# Valeurs à copier depuis Supabase (projet d'Henriquet) : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : serveur seulement, jamais dans le navigateur (utile à partir de l'intranet RH)
SUPABASE_SERVICE_ROLE_KEY=

# Adresse de l intranet d Atelier Nova (autre site Vercel). Facultatif : valeur par défaut dans le code.
NEXT_PUBLIC_INTRANET_URL=
# Adresse du service des agents (Render). Sert à le garder éveillé pendant une session.
NEXT_PUBLIC_ORCH_URL=
