# Copier en .env.local (jamais sur GitHub). Sur Vercel : Settings > Environment Variables.
# Lettre du site servi par ce déploiement : A, B ou C
PORTAIL=A
# Supabase (Project Settings > API). La clé service reste côté serveur : jamais de préfixe NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Jeton pour vider la table entre deux essais (POST /api/reset). Vide = route désactivée.
RESET_TOKEN=
# Site C seulement : 0 pour retirer l'envoi de photo (plan B « Bloqué »)
PHOTO_ACTIVE=1
